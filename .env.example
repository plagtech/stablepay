# ===========================================
# STABLEPAY ENVIRONMENT VARIABLES
# ===========================================
# Copy this to .env.local and fill in your values

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# --- Blockchain / Wallet Connect ---
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id
NEXT_PUBLIC_ONCHAINKIT_API_KEY=your_coinbase_cdp_api_key

# --- Spraay Contract Addresses ---
NEXT_PUBLIC_SPRAAY_BASE=0x...
NEXT_PUBLIC_SPRAAY_ETHEREUM=0x...
NEXT_PUBLIC_SPRAAY_ARBITRUM=0x...
NEXT_PUBLIC_SPRAAY_POLYGON=0x...
NEXT_PUBLIC_SPRAAY_AVALANCHE=0x...
NEXT_PUBLIC_SPRAAY_BNB=0x...
NEXT_PUBLIC_SPRAAY_UNICHAIN=0x...
NEXT_PUBLIC_SPRAAY_PLASMA=0x...
NEXT_PUBLIC_SPRAAY_BOB=0x...
NEXT_PUBLIC_SPRAAY_BITTENSOR=0x...

# --- USDC Contract Addresses ---
NEXT_PUBLIC_USDC_BASE=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
NEXT_PUBLIC_USDC_ETHEREUM=0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48
NEXT_PUBLIC_USDC_ARBITRUM=0xaf88d065e77c8cC2239327C5EDb3A432268e5831
NEXT_PUBLIC_USDC_POLYGON=0x3c499c542cEF5E3811e1192ce70d8cC03d5c3359

# --- Email (Resend) ---
RESEND_API_KEY=your_resend_api_key

# --- App ---
NEXT_PUBLIC_APP_URL=https://stablepay.me
NEXT_PUBLIC_APP_NAME=StablePay
